# ---------------------------------------------------------------- service
NODE_ENV=production
HOST=127.0.0.1
PORT=8080

# ---------------------------------------------------------------- sources
# Yahoo needs no key and is on by default. It is NOT licensed for commercial
# redistribution: it is a development source and a cross-check, never the
# sole basis of a production feed.
YAHOO_ENABLED=true

# A second source on a genuinely DIFFERENT feed is what turns a suspected
# halt into a corroborated one. Two vendors reselling one IEX tape do not
# count, and /api/health will keep reporting canCorroborateHalts: false.
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_FEED=iex

FINNHUB_API_KEY=
FINNHUB_FEED=finnhub
# Leave false on the free tier: `t` can carry the poll time on a quiet
# symbol, and a vendor that stamps a stale quote with the current clock makes
# a frozen tape look live.
FINNHUB_PRINT_TIME=false

# ------------------------------------------------------------------ chain
RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663
TAPEGUARD_ADDRESS=

# The signer is what the system's trust rests on. The relayer only pays gas.
# Keep them separate: the relayer is a hot wallet you can rotate freely.
ORACLE_SIGNER_KEY=
RELAYER_KEY=
